{
  "schemaVersion": 1,
  "id": "vanta",
  "version": "${version}",
  "name": "Vanta",
  "description": "Client-side PvP optimization suite for responsiveness, clarity, and frametime stability.",
  "authors": [
    "Vanta"
  ],
  "contact": {
    "sources": "https://example.com/vanta"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.vanta.VantaMod"
    ],
    "client": [
      "dev.vanta.VantaClientMod"
    ]
  },
  "mixins": [
    "vanta.mixins.json",
    {
      "config": "vanta.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
